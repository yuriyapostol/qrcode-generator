{
  "name": "qrcode-generator",
  "version": "3.3.1",
  "description": "QR Code Generator implementation in JavaScript.",
  "author": "Yuriy Apostol",
  "license": "MIT",
  "main": "dist/core/qrcode.js",
  "module": "dist/core/qrcode.mjs",
  "types": "dist/core/qrcode.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/qrcode.d.ts",
      "require": "./dist/core/qrcode.js",
      "import": "./dist/core/qrcode.mjs"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "require": "./dist/core/*.js",
      "import": "./dist/core/*.mjs"
    },
    "./renderers/*": {
      "types": "./dist/renderers/*.d.ts",
      "require": "./dist/renderers/*.js",
      "import": "./dist/renderers/*.mjs"
    },
    "./renderers/utils/*": {
      "types": "./dist/renderers/utils/*.d.ts",
      "require": "./dist/renderers/utils/*.js",
      "import": "./dist/renderers/utils/*.mjs"
    },
    "./encodings/*": {
      "types": "./dist/encodings/*.d.ts",
      "require": "./dist/encodings/*.js",
      "import": "./dist/encodings/*.mjs"
    }
  },
  "directories": {
    "dist": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yuriyapostol/qrcode-generator.git"
  },
  "bugs": {
    "url": "https://github.com/yuriyapostol/qrcode-generator/issues"
  },
  "keywords": [
    "qr",
    "qrcode",
    "generator"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "docs:sync": "mkdir -p docs/dist && cp -R dist/core docs/dist/ && cp -R dist/encodings docs/dist/ && cp -R dist/renderers docs/dist/",
    "build:docs": "npm run build && npm run docs:sync",
    "test": "wtr",
    "test:src": "wtr --config src/web-test-runner.config.mjs",
    "test:types": "tsc -p tsconfig.import-smoke.json"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@web/test-runner": "^0.20.2",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@upng/upng-js": "^2.2.2"
  }
}
